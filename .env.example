# Local development defaults. Production values must come from the deployment
# secret manager; never commit real credentials here.
NODE_ENV=development
PORT=5000
MONOLITH_URL=http://127.0.0.1:8080
GATEWAY_REQUEST_TIMEOUT_MS=15000
SERVICE_REQUEST_TIMEOUT_MS=15000
# Required for production and docker compose:
# SESSION_SECRET=
# POSTGRES_PASSWORD=