modules = ["python-base-3.13", "nodejs-24", "postgresql-16"]
[nix]
channel = "stable-25_05"
packages = ["unzip"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server build && pnpm --filter @workspace/ayzen build && NODE_ENV=production PORT=5000 pnpm --filter @workspace/api-server start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "vm"
run = ["bash", "-c", "NODE_ENV=production PORT=5000 pnpm --filter @workspace/api-server start"]
build = ["bash", "-c", "pnpm --filter @workspace/api-server build && pnpm --filter @workspace/ayzen build"]
